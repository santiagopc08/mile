n            console.error('Failed to upload image', error);\n            throw new Error('Could not upload image.');\n        }\n    },\n\n\n    // === TIMELINE ===\n\n    async addEventComment(\n        comment: { eventId: string; author: 'el' | 'ella'; text: string },\n        supabase: SupabaseClient = defaultSupabase\n    ): Promise<void> {\n        const { error } = await supabase.from('event_comments').insert({\n            event_id: comment.eventId,\n            author: comment.author,\n            text: comment.text\n        });\n        if (error) throw error;\n    },\n\n\n    async deleteEventComment(id: string, supabase: SupabaseClient = defaultSupabase): Promise<void> {\n        const { error } = await supabase.from('event_comments').delete().eq('id', id);\n        if (error) throw error;\n    },\n\n\n    async reactToEvent(\n        id: string,\n        reactions: Record<string, string[]>,\n        supabase: SupabaseClient = defaultSupabase\n    ): Promise<void> {\n        const { error } = await supabase\n            .from('events')\n            .update({ reactions })\n            .eq('id', id);\n        if (error) throw error;\n    }\n};\n"],"mappings":";;;;;;AAAA,IAAAA,SAAA,GAAAC,OAAA;AAGO,MAAMC,eAAe,GAAAC,OAAA,CAAAD,eAAA,GAAG;EAG3B,MAAME,mBAAmBA,CAACC,IAAU,EAAEC,QAAwB,GAAGC,kBAAe,EAAmB;IAC/F,IAAI;MACA,MAAMC,OAAO,GAAGH,IAAI,CAACI,IAAI,CAACC,KAAK,CAAC,GAAG,CAAC,CAACC,GAAG,CAAC,CAAC;MAC1C,MAAMC,QAAQ,GAAG,GAAGC,MAAM,CAACC,UAAU,CAAC,CAAC,IAAIC,IAAI,CAACC,GAAG,CAAC,CAAC,IAAIR,OAAO,EAAE;MAClE,MAAMS,QAAQ,GAAG,GAAGL,QAAQ,EAAE;MAE9B,MAAM;QAAEM,KAAK,EAAEC;MAAY,CAAC,GAAG,MAAMb,QAAQ,CAACc,OAAO,CAChDC,IAAI,CAAC,UAAU,CAAC,CAChBC,MAAM,CAACL,QAAQ,EAAEZ,IAAI,CAAC;MAE3B,IAAIc,WAAW,EAAE;QACb,MAAMA,WAAW;MACrB;MAEA,MAAM;QAAEI;MAAK,CAAC,GAAGjB,QAAQ,CAACc,OAAO,CAC5BC,IAAI,CAAC,UAAU,CAAC,CAChBG,YAAY,CAACP,QAAQ,CAAC;MAE3B,OAAOM,IAAI,CAACE,SAAS;IACzB,CAAC,CAAC,OAAOP,KAAK,EAAE;MACZQ,OAAO,CAACR,KAAK,CAAC,wBAAwB,EAAEA,KAAK,CAAC;MAC9C,MAAM,IAAIS,KAAK,CAAC,yBAAyB,CAAC;IAC9C;EACJ,